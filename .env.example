NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of origins allowed to make cross-origin browser
# requests to this API. Empty (the default) means NONE are allowed —
# closed by default, per Phase 14. MUST be set explicitly in
# production, or the process refuses to start.
ALLOWED_ORIGINS=

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=localdev
PGDATABASE=anilya_erp
